<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="420"
        Width="520" Height="420"
        MinWidth="440" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        x:Class="Minutnik.MainWindow"
        Title="Minutnik">
    <Grid RowDefinitions="Auto,*,Auto" Margin="24" RowSpacing="16">
        <StackPanel Grid.Row="0" Spacing="4" HorizontalAlignment="Center">
            <TextBlock x:Name="PhaseText"
                       Text="Praca"
                       FontSize="20"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="TimerText"
                       Text="25:00"
                       FontSize="64"
                       FontWeight="Bold"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="16" VerticalAlignment="Center">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16" HorizontalAlignment="Center">
                <StackPanel Grid.Column="0" Spacing="4" Width="160">
                    <TextBlock Text="Czas pracy (min):" FontSize="13" />
                    <TextBox x:Name="WorkMinutesInput" Text="25" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4" Width="160">
                    <TextBlock Text="Czas przerwy (min):" FontSize="13" />
                    <TextBox x:Name="BreakMinutesInput" Text="5" />
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                <Button x:Name="StartPauseButton"
                        Content="Start"
                        Width="120"
                        HorizontalContentAlignment="Center"
                        Click="OnStartPauseClick" />
                <Button x:Name="ResetButton"
                        Content="Reset"
                        Width="120"
                        HorizontalContentAlignment="Center"
                        Click="OnResetClick" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="8" HorizontalAlignment="Center">
            <TextBlock x:Name="CyclesCountText"
                       Text="Ukończone cykle: 0"
                       FontSize="16"
                       FontWeight="Medium"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
